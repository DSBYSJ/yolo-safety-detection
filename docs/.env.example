# ============================================================
#  环境变量示例 —— 复制为 .env 或直接在终端 set 使用
#  说明：本项目不自动读取 .env 文件；此文件仅作速查与留档。
#        在 Windows 上设置：  set 变量名=值
#        在 run_web.bat 里设置更省事（见该文件顶部）。
# ============================================================

# ---------- 摄像头 ----------
# 本地摄像头索引。0 通常是笔记本内置，1/2 是外接 USB 或虚拟摄像头。
# 换机器后若黑屏，先跑 scripts\list_cameras.py 确认真实索引。
CAMERA_INDEX=1

# 网络视频流地址（RTSP / HTTP / RTMP / 手机推流）。
# 一旦设置，CAMERA_INDEX 与分辨率设置会被忽略。
# 例：rtsp://admin:password@192.168.1.100:554/Streaming/Channels/102
# 例：http://192.168.1.100:8080/video
CAMERA_SOURCE=

# ---------- HTTPS ----------
# 手机浏览器仅在 HTTPS 或 localhost 下允许调用摄像头。
# 留空则走 HTTP（电脑可用，手机端摄像头不可用）。
FLASK_SSL_CERT=certs/cert.pem
FLASK_SSL_KEY=certs/key.pem

# ---------- 其他 ----------
# 人脸识别节流间隔（秒）。逐帧请求是高频路径，调小会增加 CPU 占用。
FACE_INTERVAL=2.0

# 设为 1 则改用 Flask 自带开发服务器（有自动重载，但 HTTPS 下会堆积 CLOSE_WAIT）。
# 仅供本机调试，不要用于手机端逐帧检测。
APP_DEV_SERVER=

# Flask 会话密钥。留空则每次启动随机生成（重启后登录态失效）。
SECRET_KEY=

# run_web.bat 优先使用的 Python 解释器路径（一般不用设）。
PYTHON_BIN=
