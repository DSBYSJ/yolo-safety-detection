# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 数据集原始文件与生成数据（体积大，不入库）
datasets/raw/
datasets/helmet/images/
datasets/helmet/labels/
datasets/mask/images/
datasets/mask/labels/

# 训练输出
runs/

# Web 运行时产物
webapp/uploads/
webapp/static/results/
webapp/data.db
webapp/train_logs/
webapp/*.log

# 人脸底库登记照 —— 属个人生物特征信息，绝对禁止入库/公开
webapp/static/faces/
webapp/static/face_thumbs/

# 预训练权重（体积大，按需自行下载，不入库）
pretrained/
yolov8*.pt

# 训练产出的模型权重 —— 体积大（helmet.pt 64MB / mask.pt 22MB），
# 统一按 README「六之五」自行下载或从训练产物复制，不入库
models/*.pt
models/*.onnx
# 权重备份目录（同上，体积大不入库）
models/_backup_*/
# 被移除权重的暂存目录（可能含权重文件）
models/_trash/
# 人脸识别模型包（buffalo_l，188MB，超 GitHub 单文件限制）
models/face/

# HTTPS 证书与私钥 —— 含私钥，绝对禁止入库
certs/
*.pem
*.key
*.crt

# 工作区临时产物
.workbuddy/
.workbuddy-ai/
.mplcache/
logs/
output/

# 文档产物（本地生成，不入库）
*.docx
*.doc

# 系统文件
.DS_Store
Thumbs.db

# SQLite WAL 临时文件
webapp/data.db-shm
webapp/data.db-wal
webapp/data.db-journal

# 人脸识别模型（188MB，超出 GitHub 单文件限制，按 README「六之五」自行下载）
models/face/

# ------------------------------------------------------------------
# 训练产生的数据集图像（Kaggle/Roboflow 导出，体积大且含真实人脸照片，
# 第三方数据集请按其许可自行获取，不入库）
# ------------------------------------------------------------------
datasets/*/images/
datasets/*/labels/
datasets/*/data_gpu.yaml

# 其他预训练权重（yolo26 等，按需下载，不入库）
weights/

# 工作区临时文件 / 脚本日志
*.log
_todo_*.txt
_dl_*.sh
.mplconfig/
.mplcache/
.mplconfig/

# 第三方数据集说明文本（无保留价值）
*_ppe-detection.txt
*_face-mask-detection.txt
